Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 30

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false

    - Class: rviz_default_plugins/RobotModel
      Name: Robot Model
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Update Interval: 0.2

    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odometry/filtered
        Queue Size: 1
      Keep: 20
      Shape: Arrow
      Position Tolerance: 0.5
      Angle Tolerance: 0.5

    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Queue Size: 1
      Alpha: 1.0
      Color Scheme: map
      Draw Behind: true
      Update Topic:
        Value: ""

    - Class: rviz_default_plugins/PointCloud2
      Name: PointCloud
      Enabled: true
      Topic:
        Value: /rtabmap/cloud_map
        Queue Size: 1
      Size (Pixels): 4
      Style: Flat Squares
      Decay Time: 0
      Color Transformer: Intensity
      Autocompute Value Bounds: true
      Use Fixed Frame: true

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 60

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Pitch: 0.7
      Yaw: 0.785

Window Geometry:
  Width: 1920
  Height: 1440
